rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // App settings — sadece super_admin yazabilir, oturum açık herkes okuyabilir
    match /settings/{document} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.role == 'super_admin';
    }

    // Default: oturumlu kullanıcılar tam yetkili (canlı test için açıldı)
    // TODO(security): per-collection ownership / admin SDK proxy'lere taşı
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
